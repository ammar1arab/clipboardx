{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipboardX",
  "version": "0.1.0",
  "identifier": "com.ammararab.clipboardx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ClipboardX",
        "width": 460,
        "height": 520,
        "minWidth": 360,
        "minHeight": 360,
        "center": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/history.images/*-thumb.png"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "ClipboardX",
    "homepage": "https://ammar1arab.github.io/clipboardx/",
    "targets": ["deb", "nsis", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Private, keyboard-first clipboard history",
    "longDescription": "Local clipboard text and image history with search, pinning, editing, and native paste for COSMIC Wayland.",
    "linux": {
      "deb": {
        "depends": [
          "wtype"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
